{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "archdiff",
  "description": "__MSG_description__",
  "version": "0.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/Ivlad003/archdiff/tree/master/chrome#readme",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "__MSG_action__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://github.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src http://127.0.0.1:* http://localhost:* https://github.com https://api.github.com; frame-src http://127.0.0.1:* http://localhost:*"
  }
}
