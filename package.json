{
  "name": "@ivlad003/archdiff",
  "version": "0.2.0",
  "description": "Live diagrams of a TypeScript/JavaScript repository: structure, dependencies, call flows, and the architectural diff of a pull request \u2014 algorithmic, fast, no model",
  "license": "Apache-2.0",
  "author": "Ivlad003",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ivlad003/archdiff.git"
  },
  "homepage": "https://github.com/Ivlad003/archdiff#readme",
  "bugs": "https://github.com/Ivlad003/archdiff/issues",
  "keywords": [
    "architecture",
    "diagram",
    "call-graph",
    "dependency-graph",
    "pull-request",
    "review",
    "tree-sitter",
    "excalidraw",
    "drawio",
    "archimate",
    "mermaid"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "archdiff": "bin/archdiff.js"
  },
  "files": [
    "bin",
    "dist",
    "dist/wasm",
    "dist/web"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-wasm.mjs && node scripts/build-web.mjs && node scripts/pack-entry.mjs publish",
    "postpack": "node scripts/pack-entry.mjs restore",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "node --test tests/cli.test.ts tests/web.test.ts",
    "test:web": "node --test tests/page.test.ts",
    "web:build": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "web-tree-sitter": "^0.27.1"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "marked": "^18.1.1",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0"
  }
}
